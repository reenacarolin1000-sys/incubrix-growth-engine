# IncuBrix Growth Engine - Environment Configuration
# Default configurations run out-of-the-box using free public APIs and RSS feeds.
# No paid API keys or subscriptions are required to run the core engine.

# Database
DATABASE_PATH=data/database/incubrix_growth.db

# Engine Runtime Configuration
TARGET_LEADS_MIN=1000
TARGET_LEADS_EXCEPTIONAL=5000
PRIORITY_A_COUNT=25
MAX_COUNTRY_RATIO=0.60
MIN_APPROVED_COUNTRY_RATIO=0.80

# Logging & Audit
LOG_LEVEL=INFO
AUDIT_LOG_PATH=reports/engine_audit.log

# Optional external API keys (Engine falls back seamlessly to public RSS & search if left blank)
YOUTUBE_API_KEY=
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=
